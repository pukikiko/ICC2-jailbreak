# LIVI-Lite on the Weston headless kiosk session. LIVI-Lite (pukikiko/LIVI-Lite)
# is the Electron-free fork of LIVI: the same Rust core, but a Slint UI and a
# native nested compositor built against the phone's own musl GStreamer and
# Wayland. There is no AppImage, no Electron/Chromium and no glibc chroot, so
# this unit runs a plain postmarketOS binary that is up in milliseconds.
#
# livi-core starts the nested compositor, the Slint UI, the GStreamer video
# host and the Rust helper itself and stays in the foreground; its SIGTERM
# handler stops the children in order while wayland is still up. KillMode=mixed
# keeps systemd from SIGTERMing the children first; TimeoutStopSec is the
# backstop for a wedged decoder.
[Unit]
Description=LIVI-Lite head unit UI on the Weston kiosk display
After=livi-weston.service
Wants=livi-weston.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=user
Environment=WAYLAND_DISPLAY=wayland-livi
Environment=XDG_RUNTIME_DIR=/run/livi
Environment=HOME=/home/user
Environment=LIVI_KIOSK=1
# the installed layout: resources/{driver,gst-host,compositor} and ../livi-ui
Environment=LIVI_RESOURCES=/opt/livi/resources
# audio goes to the host's pipewire through its pulse socket; install.sh
# rewrites the uid. no chroot bind mounts are involved any more.
Environment=PULSE_SERVER=unix:/run/user/10000/pulse/native
EnvironmentFile=-/etc/default/livi
ExecStart=/opt/livi/livi-core
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
