#!/bin/sh
# run the glibc LIVI AppImage inside the ubuntu chroot. the release build is an aarch64
# glibc/electron binary; postmarketos is musl, so it runs in /opt/livi/rootfs with the
# host's x11 and wayland sockets and runtime dir bound in. the binds are idempotent, so a
# supervisor can restart this freely. needs root (chroot + mount).
#
# usage: livi-chroot [LIVI args...]  (same argv livi.sh passes to the AppImage)
#
# the AppImage launcher hands off to a detached livi-compositor and exits 0 on purpose
# (LIVI's src/main/index.ts: "outer launcher hands off to the nested compositor and
# exits"). a plain exec would therefore leave systemd with a finished unit and its cgroup
# would take the real app down. this stays alive as long as the compositor does, so
# Restart=always covers the app itself.
#
# stopping is staged because livi.service runs KillMode=mixed and only TERMs this
# supervisor. the app sits under the compositor, so it gets the signal first: LIVI's own
# quit path (before-quit: wireless teardown, ...) then runs with wayland still up, its
# main toplevel goes away and the compositor shuts itself down ("main UI toplevel gone ->
# shutting down"). a wedged app gets LIVI_STOP_GRACE seconds, the compositor is closed
# anyway and systemd's TimeoutStopSec SIGKILLs what is left. sending the signal to the
# whole cgroup at once instead kills the compositor into a dead wayland connection and a
# stuck quit path holds the unit in stop-sigterm for the default 90 s, which is the
# "systemctl restart livi hangs" trap.
set -eu

R=/opt/livi/rootfs
APP=/opt/LIVI.AppImage
RUNDIR="${XDG_RUNTIME_DIR:-/run/livi}"
COMPOSITOR="bin/livi-compositor -s"
STOP_GRACE=${LIVI_STOP_GRACE:-10}

# the host user's audio: pipewire's pulse server socket and the cookie that authenticates
# to it. both are bound at fixed paths and PULSE_SERVER/PULSE_COOKIE point at them, so the
# app and its helper do not need the host's /run/user/<uid> layout.
PULSE_SERVER_DIR=${LIVI_PULSE_SERVER_DIR:-/run/user/10000/pulse}
PULSE_HOME=${LIVI_PULSE_HOME:-/home/user/.config/pulse}

compositor_pid() { pgrep -f "$COMPOSITOR" 2>/dev/null | head -n 1; }

# every process under a pid. prints each child before recursing: a plain for loop's
# variable is not scoped per function in POSIX sh, so the pid must not be read after a
# deeper call has had a chance to overwrite it.
descendants() {
    for c in $(pgrep -P "$1" 2>/dev/null); do
        printf '%s\n' "$c"
        descendants "$c"
    done
}

# TERM the app's whole tree, give it STOP_GRACE seconds to quit, then close the
# compositor and exit. the tree is snapshotted first: the app sits under a `/bin/sh -c`
# wrapper (dash forks there) and killing that wrapper would disconnect the rest from the
# compositor, so the wait watches the snapshot, not a fresh walk. a graceful electron
# destroys its window, which makes the compositor exit on its own.
app_pids_alive() {
    for p in "$@"; do
        kill -0 "$p" 2>/dev/null && return 0
    done
    return 1
}

stop_app() {
    trap '' TERM INT
    pid=$(compositor_pid)
    if [ -n "$pid" ]; then
        pids=$(descendants "$pid")
        for c in $pids; do
            kill -TERM "$c" 2>/dev/null || true
        done
        i=0
        while [ "$i" -lt "$STOP_GRACE" ] && app_pids_alive $pids; do
            sleep 1
            i=$((i + 1))
        done
        kill -TERM "$pid" 2>/dev/null || true
    fi
    exit 143
}
trap stop_app TERM INT

mkdir -p "$R$RUNDIR" "$R/tmp/.X11-unix" "$R/dev" "$R/proc" "$R/sys" \
         "$R/run/dbus" "$R/run/pulse" "$R/run/pulse-cookie" \
         "$R/home/user" "$R/root/.config"

# the user systemd manager (and with it pipewire-pulse.socket) can come up after this unit
# at boot - install.sh sets linger, but a hand-started livi may still race it: the bind
# below would fail and livi would come up mute. wait for the pulse socket, capped so a
# phone with no audio stack still gets the video.
i=0
while [ ! -S "$PULSE_SERVER_DIR/native" ] && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
done

mountpoint -q "$R$RUNDIR" || mount --bind "$RUNDIR" "$R$RUNDIR"
mountpoint -q "$R/tmp/.X11-unix" || mount --bind /tmp/.X11-unix "$R/tmp/.X11-unix"
mountpoint -q "$R/dev" || mount --bind /dev "$R/dev"
mountpoint -q "$R/proc" || mount -t proc proc "$R/proc"
mountpoint -q "$R/sys" || mount -t sysfs sys "$R/sys"
# the system bus, so the python helper can talk to the host's bluetoothd (wireless
# CarPlay/Android Auto) and NetworkManager (releasing wlan0 for its AP)
mountpoint -q "$R/run/dbus" || mount --bind /run/dbus "$R/run/dbus"
mountpoint -q "$R/run/pulse" || mount --bind "$PULSE_SERVER_DIR" "$R/run/pulse"
mountpoint -q "$R/run/pulse-cookie" || mount --bind "$PULSE_HOME" "$R/run/pulse-cookie"

# a killed instance leaves its compositor sockets behind and the next bind fails; only
# this launcher starts the app, so they are always stale here
rm -f "$RUNDIR/livi-compositor.ctrl" "$RUNDIR/livi-compositor.ctrl.lock" \
      "$RUNDIR/wayland-0" "$RUNDIR/wayland-0.lock"

rc=0
chroot "$R" "$APP" "$@" || rc=$?

app_alive() { pgrep -f "$COMPOSITOR" >/dev/null 2>&1; }

# give it a moment to spawn, then hold this process open for as long as it runs
i=0
while [ "$i" -lt 15 ] && ! app_alive; do
    sleep 1
    i=$((i + 1))
done
while app_alive; do
    # backgrounded so a trapped TERM interrupts this wait and runs stop_app at once,
    # instead of waiting out a foreground sleep
    sleep 2 &
    wait $! || true
done
exit $rc
