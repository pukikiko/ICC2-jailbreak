# PulseAudio in system mode. One daemon, started before LIVI; its default
# sink is the PCM5102A DAC when the board DT provides the card, the null sink
# otherwise, so LIVI's pactl calls always find a @DEFAULT_SINK@.
[Unit]
Description=PulseAudio sound server (system mode, LIVI sink policy)
DefaultDependencies=no
After=local-fs.target livi-persist.service systemd-journald.socket
Before=livi.service shutdown.target
Wants=livi-persist.service
Conflicts=shutdown.target
StartLimitIntervalSec=0

[Service]
Type=simple
# system mode must start as root and then drops to the pulse user; the
# runtime dir is group pulse and group-writable so the dropped daemon can
# create /run/pulse/pid
Group=pulse
RuntimeDirectoryMode=0775
# the daemon drops to the pulse user before it writes the pid file, and
# systemd's RuntimeDirectory ownership is not enough on every path (the
# directory can already exist from an earlier unit); make it explicit
ExecStartPre=+/bin/chown -R pulse:pulse /run/pulse /var/lib/pulse
ExecStart=/usr/lib/livi/livi-pulse
Restart=always
RestartSec=1
RuntimeDirectory=pulse
StateDirectory=pulse
StateDirectoryMode=0770

[Install]
WantedBy=multi-user.target
