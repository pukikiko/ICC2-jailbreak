# LIVI-Lite (the native CarPlay/Android Auto head unit UI) on the weston kiosk
# session. There is no AppImage, no Electron/Chromium and no chroot here:
# /opt/livi/livi-core starts the nested compositor, the Slint UI, the
# GStreamer video host and the helper itself and stays in the foreground, so
# systemd supervises the whole stack through one process and the boot path has
# no extraction/interpreter step in it at all.
#
# livi-core's SIGTERM handler stops its children in order (UI, compositor,
# helper) while wayland is still up; KillMode=mixed keeps systemd from
# SIGTERMing the children first, and TimeoutStopSec is only the backstop for a
# wedged decoder.
[Unit]
Description=LIVI-Lite head unit UI on the Weston kiosk display
DefaultDependencies=no
After=local-fs.target livi-persist.service livi-weston.service livi-pulse.service systemd-journald.socket
Wants=livi-weston.service livi-pulse.service
Conflicts=shutdown.target
Before=shutdown.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-livi
Environment=XDG_RUNTIME_DIR=/run/livi
Environment=HOME=/home/user
Environment=LIVI_KIOSK=1
# the car panel the headless session streams to (rawplay is 800x480
# RGB565); livi-core sizes fresh projection defaults from it and livi-ui
# opens at it
Environment=LIVI_UI_SIZE=800x480
# the installed layout: resources/{driver,gst-host,compositor} and ../livi-ui
Environment=LIVI_RESOURCES=/opt/livi/resources
# audio is the system PulseAudio daemon
Environment=PULSE_SERVER=unix:/run/pulse/native
# the system GStreamer registry lives on the persistent partition, so the
# plugin scan happens only on the first boot after a flash
Environment=GST_REGISTRY=/data/livi-config/gst-registry.aarch64.bin
Environment=GST_REGISTRY_UPDATE=no
EnvironmentFile=-/etc/default/livi
ExecStart=/opt/livi/livi-core
Restart=always
RestartSec=1
KillMode=mixed
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
