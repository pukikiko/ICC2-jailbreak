#!/bin/sh
# The inner Electron app launcher.
#
# LIVI's outer launcher (out/main/main.js, kn()) starts the nested compositor
# with a command string built from
#
#   process.env.APPIMAGE ?? process.execPath
#
# plus --ozone-platform=wayland, and that command becomes the inner Electron
# app. On the phone APPIMAGE is the AppImage runtime, so AppRun runs and adds
# --no-sandbox when user namespaces are unavailable. This deployment runs the
# extracted tree, where that path is the raw Electron binary, so the inner
# process would be started without --no-sandbox and Electron fatals as root
# ("Running as root without --no-sandbox is not supported").
#
# livi.service points APPIMAGE here; add the flag and pass everything else
# through unchanged.
exec /opt/livi/app/livi --no-sandbox "$@"
