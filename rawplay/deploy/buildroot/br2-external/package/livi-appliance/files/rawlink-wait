#!/bin/sh
# start rawlink once the usb port can be a gadget. this is the service's main
# process (Type=simple), not an ExecStartPre: a synchronous `systemctl restart
# rawlink` would otherwise sit in start-pre until the port came up.
#
# the H618's OTG controller is a Mentor MUSB driven by mainline's sunxi glue;
# the board device tree pins it to peripheral mode (dr_mode = "peripheral"),
# so unlike the phone there is no role switch to force. the loop is kept for
# robustness (and for any board where a role file does exist): writing device
# to it is harmless when the controller has no role switch.
#
# then wait for the udc, unbind a gadget left bound by a previous boot or a
# hard kill, clear a stale functionfs mount, and hand the process to rawlink.
for r in /sys/class/usb_role/*/role; do
    [ -e "$r" ] && echo device > "$r" 2>/dev/null
done
while ! ls /sys/class/udc/* >/dev/null 2>&1; do
    sleep 1
done
if [ -d /sys/kernel/config/usb_gadget/g1 ]; then
    echo "" > /sys/kernel/config/usb_gadget/g1/UDC 2>/dev/null
fi
umount /dev/ffs-liviraw 2>/dev/null
# --fps 24: the H618 MUSB is PIO (no DMA) and tops out at ~19 MB/s of bulk,
# so the link carries ~24-25 of the 30 fps the panel's frames would need.
# Capturing at 30 fps saturates the sender's 2-frame window and queueing adds
# ~16 ms to every ack (measured: 57 ms at --fps 30, 41 ms at --fps 24 for the
# same 24 fps on the wire). Pacing just under the link keeps the window at
# one frame and the latency at the wire time. The panel target is 24 fps
# (livi-config.json's projectionFps, enforced in livi.service's videorate
# sink chain), so this matches what LIVI actually renders.
# --stats is what the boot-time harness reads for T5 (first frames) even when
# no reader is attached yet
#
# audio: LIVI's playback goes to the current default sink (the DAC, or the null
# sink when there is no DAC). parec's monitor of that sink is the downstream PCM
# rawlink multiplexes into the video stream at 44100/s16le/stereo. the car mic
# comes back as u8/8000 mono and is written to the pipe source livi-pulse loads,
# which is the default source LIVI's uplink captures.
#
# --latency-msec=60 --process-time-msec=20: the monitor is consumed in 20 ms pieces
# with a bounded sink latency instead of PulseAudio's few-hundred-ms default. rawlink's
# audio queue holds at most six 20 ms chunks and the unit starts playback with four
# (80 ms), so a frame-sized burst is delayed and played instead of dropped. with audio
# the run-mode video pipe is 256 KB, so only about one ffs request sits in front of PCM.
#
# changed-row updates (bands) are always on and only used when they save at least half
# the picture; pass --no-bands to rawlink to A/B the raw frame path.
export PULSE_SERVER=unix:/run/pulse/native
export HOME=/tmp
exec /opt/livi/rawlink run --wayland /run/livi/wayland-livi \
    --stick /opt/livi/usb.img --fps 24 --stats --audio \
    --audio-cmd 'sink=$(pactl get-default-sink); exec parec --device="$sink.monitor" --format=s16le --rate=44100 --channels=2 --latency-msec=60 --process-time-msec=20 --raw' \
    --audio-out /run/livi-audio/car-mic
