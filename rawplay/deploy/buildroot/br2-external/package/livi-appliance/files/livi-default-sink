#!/bin/sh
# Point PulseAudio's default sink at the DAC when it exists, at the null sink
# otherwise. Runs after the daemon is up (ExecStartPost) and retries because
# the first pactl calls race the socket. The daemon's system.pa allows local
# anonymous clients, so running as root is fine on this appliance.
#
# never exits non-zero: an ExecStartPost failure would mark the pulse unit
# failed and take the daemon down with it, which is worse than a late sink.
set -u

for i in $(seq 1 100); do
    if pactl info >/dev/null 2>&1; then
        sinks=$(pactl list short sinks 2>/dev/null || true)
        if printf '%s\n' "$sinks" | grep -q 'livi-dac'; then
            pactl set-default-sink livi-dac && exit 0
        fi
        if printf '%s\n' "$sinks" | grep -q 'livi-null'; then
            pactl set-default-sink livi-null && exit 0
        fi
    fi
    sleep 0.2
done
echo "livi-default-sink: PulseAudio never came up with a sink" >&2
exit 0
