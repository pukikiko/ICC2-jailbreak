#!/bin/sh
# Put the small persistent state on the data partition and make the rest of
# the writable paths tmpfs, so the rootfs can stay a read-only squashfs and a
# yanked power cord can not corrupt anything that matters.
#
# What is persistent (/data, ext4 label livi-data, mounted noatime,commit=1):
#   livi-config   LIVI's settings and pairing state (bind-mounted on
#                 /home/user/.config; LIVI-Lite's livi-core reads
#                 $HOME/.config/LIVI and both dirs must carry the 800x480
#                 geometry or the kiosk window is rejected)
#   bluetooth     BlueZ pairings (bind-mounted on /var/lib/bluetooth)
#
# Everything else under $HOME (caches, logs, V8 code cache) is tmpfs and is
# rebuilt each boot; the read-only rootfs is never written. Without a data
# partition (a bench board, or qemu without the second disk) /data becomes a
# tmpfs and the appliance still starts, just without persistence.
set -eu

DATA=/data
WAIT=25

mkdir -p "$DATA"
# find the data partition without udev: root is mounted from the same device,
# so the node is already in devtmpfs. the fixed names cover the qemu virtio
# disk and the board's SD/eMMC; the by-label symlink (when udev did run) is
# the last candidate. the poll is only for an mmc card scanned a moment after
# init; it is instantaneous on qemu and after a normal SD boot.
dev=""
i=0
while [ "$i" -lt "$WAIT" ]; do
    for c in /dev/vda2 /dev/mmcblk0p3 /dev/mmcblk1p3 /dev/disk/by-label/livi-data; do
        if [ -b "$c" ]; then
            dev="$c"
            break
        fi
    done
    [ -n "$dev" ] && break
    sleep 0.2
    i=$((i + 1))
done

if [ -n "$dev" ]; then
    # commit=1 bounds how much recent metadata can be lost to a power cut;
    # the data is tiny and written rarely, so the cost is irrelevant
    mount -o noatime,commit=1 "$dev" "$DATA" 2>/dev/null || true
fi

if mountpoint -q "$DATA"; then
    echo "livi-persist: persistent state on $dev" >&2
else
    mount -t tmpfs -o mode=0755,size=16M tmpfs "$DATA"
    echo "livi-persist: no data partition, using tmpfs" >&2
fi

mkdir -p "$DATA/livi-config/LIVI" "$DATA/livi-config/LIVI-vnc" "$DATA/bluetooth"

# a writable, non-persistent $HOME: the app writes caches and logs there. the
# two config dirs are bind-mounted back in from /data below.
mkdir -p /home/user
if ! mountpoint -q /home/user; then
    mount -t tmpfs -o mode=0755,size=256M tmpfs /home/user
fi
mkdir -p /home/user/.config /var/lib/bluetooth

if ! mountpoint -q /home/user/.config; then
    mount --bind "$DATA/livi-config" /home/user/.config
fi
if ! mountpoint -q /var/lib/bluetooth; then
    mount --bind "$DATA/bluetooth" /var/lib/bluetooth
fi

# replace a scalar setting's value in place, or insert the key into the
# object when it is missing entirely
set_livi_value() {
    cfg=$1 key=$2 value=$3
    if grep -q "\"$key\"" "$cfg" 2>/dev/null; then
        sed -i "s/\"$key\": *[^,}]*/\"$key\": $value/" "$cfg"
    else
        sed -i "1s/{/{\n  \"$key\": $value,/" "$cfg"
    fi
}

set_livi_string() {
    set_livi_value "$1" "$2" "\"$3\""
}

# seed a fresh data partition with the shipped settings, then enforce the
# appliance defaults on every boot: wireless Android Auto on
# (wirelessAaEnabled), the Wi-Fi adapter reserved for the AP (Dedicated
# interface -> wifiDedicatedInterface), the Bluetooth/Wi-Fi/head-unit name
# (carName = Ford Falcon), the phone-facing AP on 2.4 GHz channel 6 under the
# Australian regulatory domain (wifiType/wifiChannel/country) and the
# projected video at 24 fps (projectionFps). Seeding alone would leave an
# already-flashed /data partition on the old values, so existing files are
# merged in place and never replaced (pairing state and other user settings
# are preserved).
ensure_livi_settings() {
    cfg=$1
    set_livi_value "$cfg" wirelessAaEnabled true
    set_livi_value "$cfg" wifiDedicatedInterface true
    set_livi_string "$cfg" carName "Ford Falcon"
    set_livi_string "$cfg" wifiType "2.4ghz"
    set_livi_value "$cfg" wifiChannel 6
    set_livi_string "$cfg" country "AU"
    set_livi_value "$cfg" projectionFps 24
}
for d in LIVI LIVI-vnc; do
    if [ ! -f "/home/user/.config/$d/config.json" ] \
        || ! grep -q '{' "/home/user/.config/$d/config.json" 2>/dev/null; then
        cp /usr/share/livi/config.json "/home/user/.config/$d/config.json"
    else
        ensure_livi_settings "/home/user/.config/$d/config.json"
    fi
done

# GST_REGISTRY_UPDATE=no makes the plugin cache sticky: a decoder plugin an
# upgrade adds would never register because the cache is never rescanned.
# When the video engine is in the kernel and the cached registry predates
# the v4l2 stateless decoders, drop it; with no cache livi's next start
# rescans anyway and writes a fresh one.
reg=$DATA/livi-config/gst-registry.aarch64.bin
if [ -e /dev/media0 ] && [ -s "$reg" ] && ! grep -aq v4l2slh264dec "$reg" 2>/dev/null; then
    rm -f "$reg"
    echo "livi-persist: dropped the stale GStreamer registry (no v4l2 decoder)" >&2
fi

# systemd wants a real machine-id and BlueZ keys some state on it. persist
# one so pairings keep working, and fall back to generating a fresh one.
if [ ! -s "$DATA/machine-id" ]; then
    cat /proc/sys/kernel/random/uuid | tr -d -- '-' > "$DATA/machine-id"
fi
if [ ! -s /etc/machine-id ] || [ "$(cat /etc/machine-id 2>/dev/null)" != "$(cat "$DATA/machine-id")" ]; then
    mount --bind "$DATA/machine-id" /etc/machine-id 2>/dev/null || true
fi
