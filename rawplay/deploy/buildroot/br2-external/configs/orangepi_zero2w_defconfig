# Orange Pi Zero 2W (Allwinner H618, aarch64) release image: rawlink's gadget
# and sender, headless weston and LIVI on a read-only squashfs with a small
# ext4 data partition. based on Buildroot's orangepi_zero2w_defconfig; the
# differences are systemd, the appliance packages, the boot script and the
# trimmed rootfs.
#
# pin: Buildroot 2026.08 (weston 15). the 2026.02 LTS ships weston 14, whose
# headless backend has no seat, so --fake-seat is missing and touch/Electron
# break; see README.md.
#
# hardware caveats that make this image incomplete for wireless use are
# documented in README.md ("Needs a decision"): the UWE5622 Wi-Fi/BT has no
# mainline driver, and neither has the H618 I2S the PCM5102A needs.

BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_ENABLE_LOCALE=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_LIVI_APPLIANCE_PATH)/patches"

BR2_INIT_SYSTEMD=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LIVI_APPLIANCE_PATH)/board/common/busybox.fragment"
BR2_TARGET_GENERIC_HOSTNAME="livi"
BR2_TARGET_GENERIC_ISSUE="LIVI appliance"
# the release image has no serial console (kernel cmdline sets console=ttynull
# and no getty is enabled); the debug defconfig is the one with a UART shell
BR2_TARGET_GENERIC_GETTY_PORT=""
# ssh for maintenance over the phone-facing AP (the release image has no
# UART shell). The unit starts with multi-user, long after livi's path, so it
# doesn't move the boot meter; /etc/default/dropbear is seeded with -B so the
# blank-password root login works, exactly as the debug image does.
BR2_PACKAGE_DROPBEAR=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LIVI_APPLIANCE_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LIVI_APPLIANCE_PATH)/board/orangepi_zero2w/post-image.sh"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.111"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LIVI_APPLIANCE_PATH)/board/orangepi_zero2w/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h618-orangepi-zero2w"
# Plain uncompressed Image, by measurement: the 38 MB Image reads from the
# boot FAT in ~1.65 s at 23 MB/s, while the same kernel as Image.zst reads
# in 0.5 s but U-Boot's zstd decoder needs 2.6-3.1 s for it (measured with
# and without CONFIG_ZSTD_LIB_MINIFY). Uncompressed wins on this board until
# the kernel itself is trimmed. U-Boot's lz4 cannot help: its magic check
# does not match the kernel's legacy lz4 frames.
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# the UWE5622 SDIO bus (mmc1 + wifi regulators/pwrseq): a DTS-only patch,
# so no driver is built into the kernel. The driver itself is the
# out-of-tree package below, built against this same kernel tree.
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_LIVI_APPLIANCE_PATH)/board/orangepi_zero2w/kernel-patches"

BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION_VALUE="v2.11"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"

BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="orangepi_zero2w"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LIVI_APPLIANCE_PATH)/board/orangepi_zero2w/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="SCP=/dev/null"

BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_128K=y
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_TARGET_ROOTFS_EXT2 is not set

# systemd trims: keep journald, udev, tmpfiles and the analyze tool; drop
# everything the appliance never uses
BR2_PACKAGE_SYSTEMD_ANALYZE=y
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_TIMESYNCD is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_MYHOSTNAME is not set
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_RANDOMSEED is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set

# the appliance. LIVI-Lite builds against the image's own GStreamer, Wayland
# and Mesa: the Electron-only libraries (GTK3/X11/CUPS/NSS/Pango) and Python
# are gone.
BR2_PACKAGE_LIVI_APPLIANCE=y
# the H616 video engine (cedrus) and Mali-G31 (panfrost) load at boot:
# /dev/media0 and /dev/dri/renderD128 exist before LIVI and weston start
BR2_PACKAGE_LIVI_APPLIANCE_GPU=y
# LIVI's video and audio hosts feed their GStreamer pipelines through appsrc
# (h265parse ! avdec_h265 ! waylandsink, and the audio counterpart). Without
# the base "app" plugin the pipelines fail to parse ("no element appsrc"),
# the phone's session still establishes but the panel keeps showing LIVI's
# own UI. This is the one plugin the pipeline needs beyond the defaults.
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
# GStreamer's videoconvert is the video path's only CPU-heavy step: with the
# nested compositor on llvmpipe/pixman the hardware decoder's NV12 frames are
# converted to the sink's shm BGRx. Without ORC that conversion runs the
# scalar C path (~170 ms per 800x480 frame, ~6 fps, verified on the board);
# ORC gives it the SIMD kernels (the same conversion becomes a few ms).
BR2_PACKAGE_ORC=y
# the v4l2 stateless decoders (v4l2slh264dec/v4l2slh265dec) for the cedrus
# video engine; the plugin registers elements only when /dev/media0 exists,
# so the qemu image carries it inert and the board decodes in hardware
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_V4L2CODECS=y
# LIVI-Lite's CarPlay stack (livi-cp) links OpenSSL on Linux, so the image
# carries the libraries it links against.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL=y
# UWE5622 Wi-Fi/BT (out-of-tree modules + wcnmodem.bin + hciattach_opi service);
# wpa_supplicant joins networks for bench work, hostapd (via livi-appliance)
# serves the phone-facing AP, hciattach_opi (sprd protocol) binds /dev/ttyBT0
BR2_PACKAGE_UWE5622=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
# weston 15's headless backend links pango (text in the debug/headless
# path); the Electron image had it in via GTK, the native image needs it explicit
BR2_PACKAGE_PANGO=y
BR2_PACKAGE_MESA3D=y
# The nested compositor renders through EGL; with a render node that is
# panfrost (the Mali-G31 through the board kernel-patches nodes): weston runs
# GL, livi-compositor's EGL binds the GPU and waylandsink hands the v4l2
# decoder's dmabufs straight to it. softpipe is the no-GPU fallback.
#
# llvmpipe/LLVM is deliberately NOT built on the board: libgallium (which
# every GL client loads) then links libLLVM.so, and at boot weston and
# livi-compositor between them fault in ~65 MB of LLVM from the read-only
# squashfs on the SD card - measured as ~2 s of weston's 3.2 s start. The
# board never picks llvmpipe (panfrost is always present), so dropping it
# removes 65 MB from the rootfs and from every boot. The qemu image keeps
# llvmpipe: it has no /dev/dri and really is software.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
