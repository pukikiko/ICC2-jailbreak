# Kernel config fragment for the appliance, applied on top of the arm64
# defconfig. Everything the boot path needs is built in: there is no module
# loading during boot. The defconfig already has most of the SoC, MMC, EXT4
# and DRM support; this pins the gadget stack and the pieces it leaves out.
#
# VERIFY notes are in README.md ("Needs a decision"): the H618's Wi-Fi/BT
# (Unisoc UWE5622) and its I2S DAC have no mainline drivers, so no wireless
# or PCM5102A driver is enabled here.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# the OTG port is a sunxi MUSB controller (allwinner,sun50i-h616-musb); the
# gadget role matters because the car is the host. arm64 defconfig builds the
# driver in but leaves the role at host.
CONFIG_USB_MUSB_GADGET=y
# CONFIG_USB_MUSB_HOST is not set
# CONFIG_USB_MUSB_DUAL_ROLE is not set
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NULL_TTY=y
# Bluetooth core is on so bluetoothd can run once the UWE5622 driver lands
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
# RFCOMM is the classic-Bluetooth channel wireless CarPlay and Android Auto
# settle their session on before the phone joins the head unit's AP. It is
# not in the arm64 defconfig, and without it BlueZ's iAP/AA profile servers
# fail with "socket(STREAM, RFCOMM): Protocol not supported" and nothing of
# the car shows up in a phone's Bluetooth scan. Built as a module: BlueZ's
# first RFCOMM socket autoloads it through the kernel's bt-proto-3 alias.
CONFIG_BT_RFCOMM=m
CONFIG_CFG80211=y
CONFIG_MAC80211=y
# the H616 video engine (H.264/HEVC decode) and its SRAM claim come from the
# board kernel-patches backports; module sunxi-cedrus is loaded at boot by
# livi-appliance when BR2_PACKAGE_LIVI_APPLIANCE_GPU is set. MEDIA_SUPPORT
# stays the arm64 defconfig's =m, so the media core rides in modules.
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=m
# the VE's two IOMMU ports (the node lists both); without this the engine
# runs on physical addresses and reference-frame reads can fault
CONFIG_SUN50I_IOMMU=y
# the GPU's PRCM power domain (patch 0007): without it panfrost's probe
# hangs the board. Panfrost itself needs the H616 sequencing backports
# (0008-0010) before the GPU can be used; the module is loaded at boot by
# livi-appliance (the gpu modules-load) and weston then runs GL.
CONFIG_SUN50I_H6_PRCM_PPU=y
# panfrost (the Mali-G31 backport node) is already =m through the arm64
# defconfig; 0008-0010 patch the module for the H616's power sequencing
# no tracing/debug in the boot path
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_DEBUG_INFO is not set

# the homebrew stick is a FAT partition served over mass storage; the unit
# mounts it and so does unit-sim's smoke check
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
