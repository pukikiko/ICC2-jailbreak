# Kernel config fragment for the qemu aarch64 virt appliance, on top of
# Buildroot's minimal board/qemu/aarch64-virt/linux.config.
#
# qemu virt has no USB device controller: dummy_hcd provides both a virtual
# host controller and a virtual UDC so rawlink can bind a real configfs/
# FunctionFS gadget and unit-sim (libusb, in the same guest) can enumerate it
# at high speed. mac80211_hwsim gives hostapd/LIVI's helper a wlan; hci_vhci
# gives BlueZ a character device but no controller (there is no way to model
# a phone's BT, see README.md).
#
# Buildroot's minimal qemu config predates systemd; these are the pieces
# systemd refuses to boot without (cgroups, namespaces, fhandle) and the
# filesystem bits the read-only rootfs and /data need.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NULL_TTY=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIVHCI=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HWSIM=y

# the homebrew stick is a FAT partition served over mass storage; the unit
# mounts it and so does unit-sim's smoke check
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
