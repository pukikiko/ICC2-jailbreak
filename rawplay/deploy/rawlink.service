# rawlink in appliance mode: the functionfs gadget (vendor video interface + the homebrew
# stick as mass storage) plus the sender that captures the headless weston session over
# the wayland socket (weston_capture_v1) and streams it to the head unit, taking
# touch/knob/button back. root for configfs and the functionfs mount.
#
# rawlink-wait forces the usb role to device, waits for the udc, unbinds the initramfs NCM
# gadget (g1) and clears any functionfs mount left behind by a hard kill, then execs
# rawlink. it is the main process, not an ExecStartPre, so `systemctl restart rawlink`
# returns at once even with the car unplugged (see the script's comments).
[Unit]
Description=rawlink: functionfs gadget + raw display link to the head unit
After=local-fs.target sys-kernel-config.mount
Wants=sys-kernel-config.mount
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/livi/rawlink-wait
Restart=always
RestartSec=1
# a graceful teardown is quick; do not sit in stop for the default 90s if the gadget or a
# blocking endpoint write wedges, the next start clears a stale functionfs mount anyway
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
